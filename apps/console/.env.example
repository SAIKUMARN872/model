# Optional API origin. Leave empty to use the current origin.
# For a local API on port 4000, set NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_BASE_URL=

# Configure only after the backend endpoint and its authorization contract exist.
NEXT_PUBLIC_CONSOLE_ENDPOINT_MODELS=
