NEXT_PUBLIC_CONSOLE_ENDPOINT_USAGE=
NEXT_PUBLIC_CONSOLE_ENDPOINT_LOGS=
NEXT_PUBLIC_CONSOLE_ENDPOINT_PROMPTS=
NEXT_PUBLIC_CONSOLE_ENDPOINT_AGENTS=
NEXT_PUBLIC_CONSOLE_ENDPOINT_BILLING=
NEXT_PUBLIC_CONSOLE_ENDPOINT_SETTINGS=
NEXT_PUBLIC_CONSOLE_ENDPOINT_GOVERNANCE=
NEXT_PUBLIC_CONSOLE_ENDPOINT_SECURITY=
NEXT_PUBLIC_CONSOLE_ENDPOINT_AUDIT=
NEXT_PUBLIC_CONSOLE_ENDPOINT_COMPLIANCE=
NEXT_PUBLIC_CONSOLE_ENDPOINT_RBAC=
NEXT_PUBLIC_CONSOLE_ENDPOINT_SSO=
NEXT_PUBLIC_CONSOLE_ENDPOINT_SLA=
NEXT_PUBLIC_CONSOLE_ENDPOINT_ENTERPRISE=
