{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "allowJs":  true,
                            "checkJs":  false,
                            "skipLibCheck":  true,
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "noEmit":  true,
                            "jsx":  "react-jsx",
                            "strict":  true
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    "src/**/*.js",
                    "src/**/*.jsx"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
