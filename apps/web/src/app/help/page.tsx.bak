"use client";

import { useState } from "react";
import Link from "next/link";
import {
  Search,
  Rocket,
  MessageCircle,
  Brain,
  FolderOpen,
  CreditCard,
  ShieldCheck,
  Settings,
  ChevronRight,
  BookOpen,
  CircleHelp,
} from "lucide-react";

const topics = [
  {
    title: "Getting started",
    description: "Learn the basics and set up your ModelNow workspace.",
    icon: Rocket,
    articles: ["Introduction to ModelNow", "Start your first conversation", "Explore the workspace"],
  },
  {
    title: "Using AI models",
    description: "Learn about models, responses, and model selection.",
    icon: Brain,
    articles: ["Choosing an AI model", "Understanding model responses", "Working with prompts"],
  },
  {
    title: "Files and Knowledge Hub",
    description: "Learn how to work with documents and knowledge sources.",
    icon: FolderOpen,
    articles: ["Upload documents", "Organize your files", "Understand Knowledge Hub"],
  },
  {
    title: "Account and billing",
    description: "Manage your account, plans, and billing questions.",
    icon: CreditCard,
    articles: ["Manage your account", "Understand subscription plans", "Payment troubleshooting"],
  },
  {
    title: "Privacy and security",
    description: "Learn about account security and privacy controls.",
    icon: ShieldCheck,
    articles: ["Account security", "Privacy settings", "Protect your information"],
  },
  {
    title: "Settings and customization",
    description: "Customize your workspace and preferences.",
    icon: Settings,
    articles: ["Manage settings", "Customize your workspace", "Notification preferences"],
  },
];

const popularArticles = [
  "How to get started with ModelNow",
  "How to upload and use a document",
  "How to choose an AI model",
  "How to manage account settings",
];

export default function HelpCenterPage() {
  const [search, setSearch] = useState("");

  const query = search.trim().toLowerCase();

  const filteredTopics = topics
    .map((topic) => ({
      ...topic,
      articles: topic.articles.filter(
        (article) =>
          !query ||
          topic.title.toLowerCase().includes(query) ||
          topic.description.toLowerCase().includes(query) ||
          article.toLowerCase().includes(query),
      ),
    }))
    .filter(
      (topic) =>
        !query ||
        topic.title.toLowerCase().includes(query) ||
        topic.description.toLowerCase().includes(query) ||
        topic.articles.length > 0,
    );

  const filteredPopular = popularArticles.filter((article) =>
    article.toLowerCase().includes(query),
  );

  return (
    <main className="min-h-screen bg-[#f7f8fa] px-4 py-8 text-[#17181a] sm:px-6 md:py-12">
      <div className="mx-auto max-w-5xl">
        <Link
          href="/help-support"
          className="inline-flex items-center gap-2 text-sm text-gray-600 transition hover:text-black"
        >
          <span aria-hidden="true">←</span>
          Back to Help & Support
        </Link>

        <section className="mt-6 rounded-3xl border border-gray-200 bg-white px-6 py-10 text-center sm:px-12 sm:py-14">
          <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-gray-100">
            <CircleHelp size={25} />
          </div>

          <h1 className="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
            How can we help?
          </h1>

          <p className="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-600 sm:text-base">
            Find answers, explore ModelNow features, and learn how to get more
            from your workspace.
          </p>

          <div className="mx-auto mt-7 flex max-w-2xl items-center gap-3 rounded-2xl border border-gray-300 bg-white px-4 py-3 transition focus-within:border-gray-500 focus-within:ring-2 focus-within:ring-gray-100">
            <Search size={20} className="shrink-0 text-gray-500" />
            <input
              type="search"
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Search help articles and topics..."
              aria-label="Search help articles and topics"
              className="w-full bg-transparent text-sm outline-none placeholder:text-gray-400"
            />
            {search && (
              <button
                type="button"
                onClick={() => setSearch("")}
                className="text-xs text-gray-500 hover:text-black"
              >
                Clear
              </button>
            )}
          </div>
        </section>

        {!query && (
          <section className="mt-10">
            <div className="mb-4 flex items-center gap-2">
              <BookOpen size={20} />
              <h2 className="text-lg font-semibold">Popular help articles</h2>
            </div>

            <div className="divide-y divide-gray-100 rounded-2xl border border-gray-200 bg-white px-5">
              {popularArticles.map((article) => (
                <div
                  key={article}
                  className="flex items-center gap-3 py-4 text-sm text-gray-700"
                >
                  <BookOpen size={17} className="shrink-0 text-gray-400" />
                  <span>{article}</span>
                  <span className="ml-auto text-gray-400">
                    <ChevronRight size={17} />
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        <section className="mt-10">
          <h2 className="mb-4 text-lg font-semibold">
            Browse help topics
          </h2>

          {filteredTopics.length > 0 ? (
            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {filteredTopics.map((topic) => {
                const Icon = topic.icon;

                return (
                  <article
                    key={topic.title}
                    className="rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-gray-300 hover:shadow-sm"
                  >
                    <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100">
                      <Icon size={21} />
                    </div>

                    <h3 className="mt-4 font-semibold">{topic.title}</h3>

                    <p className="mt-2 min-h-10 text-sm leading-5 text-gray-600">
                      {topic.description}
                    </p>

                    <div className="mt-4 space-y-1">
                      {topic.articles.map((article) => (
                        <div
                          key={article}
                          className="flex items-center gap-2 py-2 text-sm text-gray-700"
                        >
                          <span className="flex-1">{article}</span>
                          <ChevronRight
                            size={15}
                            className="shrink-0 text-gray-400"
                          />
                        </div>
                      ))}
                    </div>
                  </article>
                );
              })}
            </div>
          ) : (
            <div className="rounded-2xl border border-gray-200 bg-white p-8 text-center">
              <Search className="mx-auto text-gray-400" size={25} />
              <p className="mt-3 font-medium">No matching help topics</p>
              <p className="mt-1 text-sm text-gray-500">
                Try a different search term.
              </p>
            </div>
          )}
        </section>

        <section className="mt-10 rounded-2xl border border-gray-200 bg-white p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
          <div>
            <div className="flex items-center gap-2">
              <MessageCircle size={21} />
              <h2 className="font-semibold">Still need help?</h2>
            </div>
            <p className="mt-2 text-sm leading-6 text-gray-600">
              Need assistance with ModelNow? Visit Help & Support for the
              available support options.
            </p>
          </div>

          <Link
            href="/help-support"
            className="mt-4 inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-black px-5 py-3 text-sm font-medium text-white transition hover:bg-gray-800 sm:mt-0"
          >
            Help & Support
            <ChevronRight size={17} />
          </Link>
        </section>

        <footer className="py-8 text-center text-xs text-gray-500">
          ModelNow Help Center
        </footer>
      </div>
    </main>
  );
}
